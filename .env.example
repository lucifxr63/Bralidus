# Supabase — mismo proyecto que el app principal
# Conexión directa PostgreSQL (solo para scripts locales, NUNCA en frontend)
DATABASE_URL=postgresql://postgres.<ref>:password@aws-0-us-east-2.pooler.supabase.com:6543/postgres
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# LinkedIn OAuth (opcional)
VITE_LINKEDIN_CLIENT_ID=your-linkedin-client-id

# PostHog analytics (opcional)
VITE_POSTHOG_KEY=phc_your-key
VITE_POSTHOG_HOST=https://your-project.supabase.co/functions/v1/posthog-proxy

# Sentry (opcional)
# VITE_SENTRY_DSN=https://xxx@oyyy.ingest.sentry.io/zzz
VITE_SENTRY_RELEASE=local

# ── Solo para desarrollo local con Edge Functions ──────────────────────────────
# Nunca van al frontend. En producción se configuran como Supabase Secrets.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...
BDE_USER=your-email@example.com
BDE_PASS=your-bde-password
LLAMAPARSE_API_KEY=llx-...
SII_APIGATEWAY_KEY=your-sii-key
CMF_KEY=your-cmf-key
CMF_BEST_KEY=your-cmf-best-key
