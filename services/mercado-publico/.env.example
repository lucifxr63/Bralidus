# mp-sync — servicio de ingesta de Mercado Público (Bralidus/Animus)
# Copiar a .env para desarrollo local. En Vercel se configuran como env vars
# del proyecto. NUNCA commitear el .env con valores reales.

# ── Bases de datos (dual-write) ───────────────────────────────
# Ambas son el connection string del POOLER de Supabase del proyecto
# correspondiente (Dashboard → Project Settings → Database → Connection pooling).
#
# OJO — los dos proyectos NO usan el mismo modo de pooler, y equivocarse cuesta
# caro porque el error es engañoso:
#   Licitus  → puerto 5432 (SESSION). El 6543 (transaction) está deshabilitado
#              en ese proyecto y responde "password authentication failed", como
#              si la credencial estuviera mal.
#   Bralidus → puerto 6543 (transaction), verificado funcionando.
#
# El proyecto de Licitus figura en el dashboard como "validateai-knowledge-vault"
# (nombre heredado). Existe además un proyecto "pymengyne" que NO es este.

# Proyecto szzibobuwgcopewmnkkl — opportunities, purchase_orders, sync_logs.
LICITUS_DATABASE_URL=postgresql://postgres.szzibobuwgcopewmnkkl:PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# Proyecto fcdhcntyvsydnvjwopfe — licitaciones_mercado_publico (tabla canónica).
BRALIDUS_DATABASE_URL=postgresql://postgres.fcdhcntyvsydnvjwopfe:PASSWORD@aws-1-us-east-2.pooler.supabase.com:6543/postgres

# Interruptor del segundo destino. Ponerlo en false hace que el servicio escriba
# SOLO en Licitus — útil para validar paridad exacta con el pipeline viejo.
DUAL_WRITE_ENABLED=true

# ── Control plane (/jobs/run/*) ───────────────────────────────
# Bearer token que exigen los endpoints de jobs. Mismo contrato que BralidusPY.
# Lo usan el cron de GitHub Actions y el tab "Orquestador & Workers" del /admin.
CRON_SECRET=

# ── Callback de post-proceso hacia Licitus ────────────────────
# Este servicio NO corre análisis LLM ni notificaciones: avisa a Licitus qué
# ingestó y Licitus hace el resto. Sin URL el callback es no-op.
LICITUS_CALLBACK_URL=https://api.licitus.scouttech.lat/internal/post-ingest
LICITUS_CALLBACK_KEY=

# ── Mercado Público ───────────────────────────────────────────
MERCADO_PUBLICO_TICKET=
# MERCADO_PUBLICO_BASE_URL=http://api.mercadopublico.cl
# COMPRA_AGIL_BASE_URL=https://api2.mercadopublico.cl
# COMPRA_AGIL_ENABLED=true

# ── Alerting opcional (Discord/Slack) ─────────────────────────
# Sin URL las alertas solo se loguean.
# OPS_WEBHOOK_URL=

# ── Tuning (todos tienen default sensato) ─────────────────────
# SYNC_LOOKBACK_DAYS=1
# SYNC_LIC_CHUNK_SIZE=300
# SYNC_OC_CHUNK_SIZE=500
# SYNC_CONCURRENCY=1
# SYNC_REQUEST_DELAY_MS=200
# LOG_LEVEL=info
